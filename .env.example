# Application
APP_NAME=DocuAsk
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api
FRONTEND_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200,http://localhost:8080

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+psycopg2://docuask:docuask@localhost:5432/docuask

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Embeddings: local (BGE, no API key) | openai | hash (tests)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_DIMENSIONS=384

# Answers: auto (OpenAI if key, else extractive) | openai | ollama | extractive
# extractive = fast local answers from retrieved passages (best for demos when OpenAI is rate-limited)
# auto = OpenAI when a key is set (falls back to extractive on quota errors); openai | ollama also supported
LLM_PROVIDER=extractive
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# OpenAI (optional — used when LLM_PROVIDER=openai/auto with a key, or EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_MAX_OUTPUT_TOKENS=800

# RAG / chunking
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K_RESULTS=6
RETRIEVAL_CANDIDATES=20
RERANK_TOP_K=6
RERANKER=lexical
MAX_CONTEXT_CHARS=12000
CONVERSATION_HISTORY_MESSAGES=6

# Uploads
MAX_UPLOAD_SIZE=20971520
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage/uploads

# AWS S3 (used when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Rate limiting
AUTH_RATE_LIMIT=10/minute
UPLOAD_RATE_LIMIT=20/hour
CHAT_RATE_LIMIT=30/minute

# Optional email (password reset). In development, reset links are logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@docuask.app

# Demo account seed (optional, local/dev only)
DEMO_EMAIL=demo@docuask.app
DEMO_PASSWORD=DocuAsk123!
